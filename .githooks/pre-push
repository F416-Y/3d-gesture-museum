#!/bin/sh
# ============================================================
# 云墨美术馆 · 推送守卫
# 规则：main 是唯一主线，只接受 PR 合并，禁止直接 push（见 docs/Git-快速上手.md）
# 首次建仓 / 正式发布确实需要直推时：git push --no-verify origin main
# ============================================================

blocked=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      blocked=1
      ;;
  esac
done

if [ "$blocked" = "1" ]; then
  echo ""
  echo "  ✗ 已阻止：不允许直接 push 到 main"
  echo ""
  echo "    正确流程："
  echo "      1) git switch main && git pull origin main"
  echo "      2) git switch feature/你的分支 && git merge main"
  echo "      3) 提交后 push 你的 feature 分支，再提 PR（base 默认就是 main）"
  echo "      4) 组长 review 通过后才会合并"
  echo ""
  echo "    首次建仓、或组长正式发布时确实要直推："
  echo "      git push --no-verify origin main"
  echo ""
  exit 1
fi

exit 0
