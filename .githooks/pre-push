#!/bin/sh
# ============================================================
# 云墨美术馆 · 推送守卫
# 规则：main 只接受来自 dev 的合并，禁止直接 push（见 docs/Git-快速上手.md）
# 首次建仓 / 正式发布确实需要直推时：git push --no-verify origin main
# ============================================================

blocked=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      blocked=1
      ;;
  esac
done

if [ "$blocked" = "1" ]; then
  echo ""
  echo "  ✗ 已阻止：不允许直接 push 到 main"
  echo ""
  echo "    正确流程："
  echo "      1) git switch dev && git pull origin dev"
  echo "      2) 在 feature/* 上开发 → 提 PR 合入 dev"
  echo "      3) 组长在 dev 验证通过后，PR 合入 main 再发布"
  echo ""
  echo "    首次建仓、或组长正式发布时确实要直推："
  echo "      git push --no-verify origin main"
  echo ""
  exit 1
fi

exit 0
